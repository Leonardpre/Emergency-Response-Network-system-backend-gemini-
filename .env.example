# ==============================================================================
#  Emergency Response Network (ERN) — Environment Configuration Template
# ==============================================================================
#  INSTRUCTIONS:
#  1. Duplicate this file and rename it to: .env
#  2. Replace all placeholder values below with your actual credentials.
#  3. NEVER commit your actual .env file to public version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# The port the backend API and Socket.io server will listen on
PORT=5000

# Environment mode: 'development', 'production', or 'test'
NODE_ENV=development

# Allowed CORS origins (e.g. '*' or 'http://localhost:5173' for frontend dev)
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 2. MONGODB DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# MongoDB connection URI (Atlas Cluster or local instance).
# Requires 2dsphere indexing support for geospatial queries.
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/emergency_response_network?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Secret key used to sign and verify JSON Web Tokens (use a strong random string)
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Token expiration duration (e.g. '7d', '30d', '24h')
JWT_EXPIRES_IN=30d

# ------------------------------------------------------------------------------
# 4. EMAIL CAD NOTIFICATIONS (GMAIL / SMTP)
# ------------------------------------------------------------------------------
# Set to 'true' to enable automated email dispatch alerts on emergency SOS creation
ENABLE_EMAIL_ALERTS=false

# Email provider: 'gmail' (recommended) or 'smtp' for custom host
EMAIL_SERVICE=gmail

# SMTP host and port (default Gmail values shown)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Gmail address & 16-character App Password (generate at myaccount.google.com/apppasswords)
SMTP_USER=your_organization_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Sender display name and reply-to email address
ALERT_FROM_EMAIL="Emergency Response Network" <alerts@yourdomain.org>

# Primary duty dispatcher or monitoring inbox to receive incoming dispatch alerts
ALERT_TO_EMAIL=duty_dispatcher@yourdomain.org

# ------------------------------------------------------------------------------
# 5. OPTIONAL SMS / GSM WEBHOOK INTEGRATION (TWILIO / AFRICA'S TALKING)
# ------------------------------------------------------------------------------
# Uncomment and populate if using outbound SMS dispatch alerts
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890
